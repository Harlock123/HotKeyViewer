<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HotKeyViewer.ViewModels"
        xmlns:models="using:HotKeyViewer.Models"
        x:Class="HotKeyViewer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Hyprland Hotkeys"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True">

  <Border Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource SurfaceBorderBrush}"
          BorderThickness="1"
          CornerRadius="12">
   <Panel>
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18,14,18,12">

      <!-- Header -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="Hyperland Hotkeys"
                     FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{Binding StatusText}"
                     FontSize="{DynamicResource FontSizeSmall}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    IsVisible="{Binding ShowsOriginFilter}"
                    IsEnabled="{Binding OriginFilterEnabled}"
                    ToolTip.Tip="Origin does not apply while Duplicates is on, so no partner chord can be filtered out of view">
          <RadioButton Classes="chip" GroupName="filter" Content="All"
                       IsChecked="{Binding IsShowingAll, Mode=OneWay}"
                       Click="OnFilterAll" />
          <RadioButton Classes="chip" GroupName="filter" Content="Yours"
                       IsChecked="{Binding IsShowingCustomised, Mode=OneWay}"
                       Click="OnFilterCustomised" />
          <RadioButton Classes="chip" GroupName="filter" Content="Defaults"
                       IsChecked="{Binding IsShowingDefaults, Mode=OneWay}"
                       Click="OnFilterDefaults" />
        </StackPanel>

        <CheckBox Grid.Column="2" Classes="chipToggle" Content="Duplicates"
                  Margin="6,0,0,0" VerticalAlignment="Center"
                  IsVisible="{Binding HasDuplicates}"
                  ToolTip.Tip="Show every action reachable by more than one chord, across both yours and the defaults"
                  IsChecked="{Binding DuplicatesOnly, Mode=TwoWay}" />
      </Grid>

      <!-- Search -->
      <TextBox Grid.Row="1" Name="SearchBox"
               Classes="search"
               PlaceholderText="Search a key, an action, or a command…"
               Text="{Binding Query, Mode=TwoWay}"
               Margin="0,0,0,12" />

      <!-- Results -->
      <Panel Grid.Row="2">
        <TextBlock Text="Reading configuration…"
                   IsVisible="{Binding IsLoading}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <TextBlock Text="Nothing matches that search."
                   IsVisible="{Binding HasNoResults}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- One flat list of headings and rows, templated by type, so arrow
             keys walk the whole window and there is a single selection. -->
        <ListBox Name="RowList"
                 IsVisible="{Binding IsReady}"
                 ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

          <ListBox.DataTemplates>

            <DataTemplate DataType="vm:HotKeyGroup">
              <Button Classes="groupToggle" Click="OnToggleGroup" Margin="0,8,0,2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <!-- Two glyphs rather than one rotated by a converter. -->
                  <Path Classes="chevron"
                        Data="M 0,0 L 8,0 L 4,5 Z"
                        Width="{DynamicResource ChevronSize}"
                        Height="{DynamicResource ChevronSize}"
                        IsVisible="{Binding IsExpanded}" />
                  <Path Classes="chevron"
                        Data="M 0,0 L 5,4 L 0,8 Z"
                        Width="{DynamicResource ChevronSize}"
                        Height="{DynamicResource ChevronSize}"
                        IsVisible="{Binding IsCollapsed}" />
                  <TextBlock Classes="groupHeader" Text="{Binding Name}" VerticalAlignment="Center" />
                  <TextBlock Classes="muted" Text="{Binding CountLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>

            <DataTemplate DataType="models:HotKey">
              <Border Classes="row">
                <Grid ColumnDefinitions="Auto,*,Auto">

                  <!-- Keycaps -->
                  <ItemsControl Grid.Column="0" ItemsSource="{Binding Chord.Parts}"
                                Width="{DynamicResource KeycapColumnWidth}"
                                VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Border Classes="keycap" Margin="0,1,4,1">
                          <TextBlock Text="{Binding}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Action and command -->
                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Description}"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Command}"
                               IsVisible="{Binding HasCommand}"
                               Classes="muted"
                               FontFamily="{StaticResource MonospaceFont}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <!-- Provenance -->
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                              VerticalAlignment="Center">
                    <Border Classes="badge" IsVisible="{Binding HasDuplicates}"
                            Background="{DynamicResource BadgeBrush}"
                            ToolTip.Tip="{Binding DuplicateTooltip}">
                      <TextBlock Text="{Binding DuplicateLabel}"
                                 FontSize="{DynamicResource FontSizeBadge}" FontWeight="Bold"
                                 Foreground="{DynamicResource RemapBrush}" />
                    </Border>
                    <Border Classes="badge" IsVisible="{Binding HasBadge}"
                            Background="{DynamicResource BadgeBrush}">
                      <TextBlock Text="{Binding BadgeText}"
                                 FontSize="{DynamicResource FontSizeBadge}" FontWeight="Bold"
                                 Foreground="{DynamicResource CustomBrush}" />
                    </Border>
                    <Button Classes="sourceLink"
                            IsVisible="{Binding HasSource}"
                            Click="OnOpenSource"
                            ToolTip.Tip="{Binding SourceTooltip}"
                            MinWidth="{DynamicResource SourceColumnWidth}">
                      <TextBlock Text="{Binding SourceLabel}"
                                 FontSize="{DynamicResource FontSizeSmall}"
                                 TextAlignment="Right" />
                    </Button>
                  </StackPanel>

                </Grid>
              </Border>
            </DataTemplate>

          </ListBox.DataTemplates>
        </ListBox>
      </Panel>

      <!-- Footer -->
      <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="10,10,0,0">
        <TextBlock Grid.Column="0" Classes="muted"
                   Text="{Binding WarningText}"
                   IsVisible="{Binding HasWarning}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Classes="muted"
                   Text="↑↓ select  ·  Enter opens the source  ·  Delete removes  ·  Ctrl+E all  ·  Esc to close" />
      </Grid>

    </Grid>

    <!-- Confirmation overlay. Inside the main window on purpose: a separate
         toplevel opens without keyboard focus under Wayland. -->
    <Border IsVisible="{Binding HasPendingRemoval}"
            Background="#B0000000"
            CornerRadius="12">
      <Border Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource SurfaceBorderBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Margin="40"
              Padding="24"
              MaxWidth="760"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <ContentControl Content="{Binding PendingRemoval}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:RemovalRequest">
              <StackPanel Spacing="14">

          <TextBlock Text="{Binding Heading}"
                     FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     TextWrapping="Wrap" />

          <TextBlock Text="{Binding Explanation}"
                     FontSize="{DynamicResource FontSizeBody}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />

          <!-- The exact edit, so nothing is written that was not shown first. -->
          <Border Background="{DynamicResource KeycapBrush}"
                  BorderBrush="{DynamicResource KeycapBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,10">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Target}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Preview}"
                         FontFamily="{StaticResource MonospaceFont}"
                         FontSize="{DynamicResource FontSizeSmall}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="A timestamped backup is written first, and the change is rolled back automatically if Hyprland rejects the config." />

          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="chipButton" Content="Cancel  (Esc)" Click="OnCancelRemoval" />
            <Button Classes="chipButton danger" Content="Remove  (Enter)" Click="OnConfirmRemoval" />
          </StackPanel>

        </StackPanel>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Border>
    </Border>
   </Panel>
  </Border>
</Window>
