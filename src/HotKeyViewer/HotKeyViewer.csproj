<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>hotkeyviewer</AssemblyName>
    <RootNamespace>HotKeyViewer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.1" />
  </ItemGroup>

  <!-- Monolithic publish settings, applied only when a publish actually asks
       for them so the everyday build stays fast and needs no native toolchain.
       See packaging/build.sh. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <!-- Debug info goes to a separate .dbg, which keeps the shipped binary
         small while still allowing a core dump to be symbolicated later. -->
    <StripSymbols>true</StripSymbols>
    <!-- This is a keypress-launched utility, so favour startup over size. -->
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sources/scan-lua-config.lua" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HotKeyViewer.Tests" />
  </ItemGroup>

</Project>
